<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Category for Equipment Loan -->
    <record id="module_category_equipment_loan" model="ir.module.category">
        <field name="name">Préstamos de Equipos</field>
        <field name="description">Gestión de permisos para préstamos de equipos</field>
        <field name="sequence">20</field>
    </record>

    <!-- Manager Group -->
    <record id="group_equipment_loan_manager" model="res.groups">
        <field name="name">Gestor de préstamos</field>
        <field name="category_id" ref="module_category_equipment_loan"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record Rules -->
    <!-- Regular user can create and only see their own loans -->
    <record id="equipment_loan_rule_user" model="ir.rule">
        <field name="name">Préstamos: ver solo préstamos propios</field>
        <field name="model_id" ref="model_equipment_loan"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Manager can see and manage all loans -->
    <record id="equipment_loan_rule_manager" model="ir.rule">
        <field name="name">Préstamos: ver todos los préstamos (Gestor)</field>
        <field name="model_id" ref="model_equipment_loan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_equipment_loan_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
