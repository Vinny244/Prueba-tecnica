<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_approval_level_view_list" model="ir.ui.view">
        <field name="name">payment.approval.level.list</field>
        <field name="model">payment.approval.level</field>
        <field name="arch" type="xml">
            <list string="Niveles de aprobación" editable="bottom">
                <field name="name"/>
                <field name="min_amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="approver_id" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="payment_approval_level_action" model="ir.actions.act_window">
        <field name="name">Niveles de aprobación</field>
        <field name="res_model">payment.approval.level</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
